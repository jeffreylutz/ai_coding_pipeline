# Automation Configuration for Agentic Coding Pipeline Container
# This file contains configuration settings for build and test automation

# Image Configuration
IMAGE_NAME=agentic-coding-pipeline
IMAGE_TAG=latest
REGISTRY=ghcr.io
PLATFORMS=linux/amd64,linux/arm64

# Build Configuration
DOCKER_BUILDKIT=1
BUILD_CACHE_TYPE=registry
BUILD_PARALLEL=true
BUILD_TIMEOUT=3600
BUILD_ARGS=""

# Test Configuration
TEST_TIMEOUT=600
TEST_PARALLEL=true
TEST_CLEANUP=true
TEST_RESULTS_DIR=./test-results
RUN_UNIT_TESTS=true
RUN_INTEGRATION_TESTS=true
RUN_PROPERTY_TESTS=true
RUN_PERFORMANCE_TESTS=true
RUN_SECURITY_TESTS=false

# Deployment Configuration
DEFAULT_ENVIRONMENT=local
STAGING_NAMESPACE=staging
PRODUCTION_NAMESPACE=production
DEPLOYMENT_TIMEOUT=600
ROLLBACK_ON_FAILURE=true

# CI/CD Configuration
CI_REGISTRY_PUSH=false
CI_RUN_SECURITY_SCANS=true
CI_GENERATE_REPORTS=true
CI_NOTIFY_ON_FAILURE=false
CI_PARALLEL_JOBS=4

# Performance Thresholds
MAX_IMAGE_SIZE_GB=8
MAX_STARTUP_TIME_SECONDS=60
MAX_MEMORY_USAGE_GB=4
MIN_CPU_CORES=2

# Security Configuration
SECURITY_SCAN_ENABLED=false
VULNERABILITY_SCAN_ENABLED=false
COMPLIANCE_CHECK_ENABLED=false
SECURITY_REPORT_FORMAT=json

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_LOGGING=true
LOG_LEVEL=info
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Development Configuration
DEV_MOUNT_SOURCE=false
DEV_ENABLE_DEBUG=true
DEV_HOT_RELOAD=false
DEV_EXPOSE_ALL_PORTS=true

# Notification Configuration
SLACK_WEBHOOK_URL=""
EMAIL_NOTIFICATIONS=false
NOTIFICATION_CHANNELS=""

# Environment-Specific Overrides
# Local Environment
LOCAL_DEBUG=true
LOCAL_LOG_LEVEL=debug
LOCAL_ENABLE_EXPERIMENTAL=true

# Staging Environment
STAGING_DEBUG=true
STAGING_LOG_LEVEL=debug
STAGING_RESOURCE_LIMITS_MEMORY=4Gi
STAGING_RESOURCE_LIMITS_CPU=2000m

# Production Environment
PRODUCTION_DEBUG=false
PRODUCTION_LOG_LEVEL=info
PRODUCTION_RESOURCE_LIMITS_MEMORY=16Gi
PRODUCTION_RESOURCE_LIMITS_CPU=8000m
PRODUCTION_ENABLE_MONITORING=true
PRODUCTION_ENABLE_BACKUP=true

# Tool Configuration
HADOLINT_CONFIG=.hadolint.yaml
SHELLCHECK_CONFIG=.shellcheckrc
YAMLLINT_CONFIG=.yamllint.yml
PYTEST_CONFIG=pytest.ini

# Cache Configuration
CACHE_REGISTRY_URL=${REGISTRY}
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_GB=50
CACHE_CLEANUP_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=s3

# Advanced Configuration
EXPERIMENTAL_FEATURES=false
BETA_FEATURES=false
FEATURE_FLAGS=""
CUSTOM_BUILD_HOOKS=""
CUSTOM_TEST_HOOKS=""
CUSTOM_DEPLOY_HOOKS=""